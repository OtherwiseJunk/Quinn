# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Groq
GROQ_API_KEY=

# Optional: model overrides (all default to openai/gpt-oss-120b)
#GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-120b
#GROQ_REPLY_MODEL=openai/gpt-oss-120b
#GROQ_CONSOLIDATION_MODEL=openai/gpt-oss-120b

# Optional: send Discord images to the model. Off by default — qwen/qwen3.6-27b
# is currently the only vision-capable Groq model and it is priced out of reach.
# Only enable this with a vision model in EVERY model slot above: image parts
# sent to a text-only model make Groq reject the request with
# 400 "content must be a string". While off, images become a text placeholder.
#GROQ_IMAGE_INPUT_ENABLED=false

# Database
POSTGRES_USER=quinn
POSTGRES_PASSWORD=changeme
POSTGRES_DB=quinn
DATABASE_URL=postgresql://quinn:changeme@postgres:5432/quinn

# Server
SERVER_PORT=3000
SESSION_SECRET=changeme
# Dev: http://localhost:5173 | Prod: http://localhost (nginx handles it)
UI_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173
INTERNAL_BOT_SECRET=changeme
SERVER_URL=http://localhost:3000

# Bot owner Discord user ID (for owner-level UI access)
BOT_OWNER_ID=
